{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SUMO Traffic Rule Schema",
  "description": "JSON schema for defining traffic rules to be compiled into SUMO vehicle types and TraCI dynamics",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "description": "Rule version identifier (e.g., 'v001')"
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of this rule set"
    },
    "vehicle_types": {
      "type": "array",
      "description": "Vehicle type definitions",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Vehicle type ID (e.g., 'car', 'moto')"
          },
          "vClass": {
            "type": "string",
            "enum": ["passenger", "motorcycle", "truck", "bus"],
            "description": "SUMO vehicle class"
          },
          "length": {
            "type": "number",
            "description": "Vehicle length in meters"
          },
          "width": {
            "type": "number",
            "description": "Vehicle width in meters"
          },
          "maxSpeed": {
            "type": "number",
            "description": "Maximum speed in m/s"
          },
          "accel": {
            "type": "number",
            "description": "Maximum acceleration in m/s²"
          },
          "decel": {
            "type": "number",
            "description": "Maximum deceleration in m/s²"
          },
          "sigma": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Driver imperfection (0=perfect, 1=random)"
          },
          "tau": {
            "type": "number",
            "description": "Reaction time in seconds"
          },
          "minGap": {
            "type": "number",
            "description": "Minimum gap to following vehicle in meters"
          },
          "laneChangeParams": {
            "type": "object",
            "description": "Lane change behavior parameters",
            "properties": {
              "lcStrategic": {"type": "number"},
              "lcCooperative": {"type": "number"},
              "lcSpeedGain": {"type": "number"},
              "lcKeepRight": {"type": "number"},
              "lcAssertive": {"type": "number"},
              "lcPushy": {"type": "number"}
            }
          }
        },
        "required": ["id", "vClass", "maxSpeed"]
      }
    },
    "traci_rules": {
      "type": "array",
      "description": "Runtime rules to enforce via TraCI",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Rule name"
          },
          "condition": {
            "type": "string",
            "description": "Python condition to check (e.g., 'speed > 10')"
          },
          "action": {
            "type": "string",
            "description": "Python code to execute when condition is true"
          }
        },
        "required": ["name", "condition", "action"]
      }
    }
  },
  "required": ["version", "vehicle_types"]
}
