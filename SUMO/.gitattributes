# byte-compared snapshots (tests/test_compiler.py): never convert line endings
tests/snapshots/** -text
# compiler output (byte-compared to the spec's compilation in tests/test_compiler.py, hashed into run manifests):
# LF on every checkout, as thesis_sumo.rules.compiler writes it
rules/compiled/** text eol=lf
# shell scripts must keep LF so they run on Linux after a Windows checkout (core.autocrlf=true)
*.sh text eol=lf
