# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Raw SUMO run outputs (large, reproducible from manifest.json). Each run's manifest.json and collisions.xml are
# tracked (small) so run records and the R28 thresholds can be checked on both the Windows and the Linux machine.
experiments/runs/**
!experiments/runs/**/
!experiments/runs/**/manifest.json
!experiments/runs/**/collisions.xml
# campaigns (thesis_sumo.evaluate / baselines.optuna_search): runs as above; budget.json, study.journal,
# convergence.csv, validity_log.csv and compiled/<spec_id>/ stay tracked; pickled EvalResults are local only
experiments/campaigns/*/runs/**
!experiments/campaigns/*/runs/**/
!experiments/campaigns/*/runs/**/manifest.json
!experiments/campaigns/*/runs/**/collisions.xml
experiments/campaigns/*/optuna_results/*.pkl
# validator outcomes (thesis_sumo.rules.validator.ValidityLog), runtime output
experiments/validity_log.csv

# Video (processed outside this repo)
*.mp4
*.mov
*.avi
*.mkv

# Tooling scratch; the SDD ledger (.superpowers/sdd/) is tracked so work can resume on either machine
.superpowers/*
!.superpowers/sdd/

# Personal Claude Code settings
.claude/settings.local.json

# netconvert logs written by thesis_sumo.net.build
scenario/net/logs/

# raw output of the Phase 3A toy experiment (reproducible: experiments/phase3a/right_lane_blocking.py)
experiments/phase3a/runs/
